<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime exceptions a Unity Mono build needs (PURR3D-14). Notarisation requires the hardened runtime,
  which by default forbids writing code into memory and loading libraries signed by someone else.
  - allow-jit, allow-unsigned-executable-memory: Mono compiles C# to machine code while the game runs.
  - disable-library-validation: Unity's own native plugins (and Mono) aren't signed with your Team ID.
  An IL2CPP build compiles ahead of time and can usually drop the first two.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
