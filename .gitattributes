# Unity serialises scenes, prefabs and assets as YAML text (Force Text mode):
# keep them in git as text, merged with UnityYAMLMerge where configured.
*.unity    text eol=lf merge=unityyamlmerge
*.prefab   text eol=lf merge=unityyamlmerge
*.asset    text eol=lf merge=unityyamlmerge
*.mat      text eol=lf merge=unityyamlmerge
*.anim     text eol=lf merge=unityyamlmerge
*.controller text eol=lf merge=unityyamlmerge
*.meta     text eol=lf
*.cs       text eol=lf
*.asmdef   text eol=lf
*.json     text eol=lf

# Binary assets under Assets/ go to Git LFS.
# Images under docs/ stay as plain git objects so the README renders anywhere.
Assets/**/*.[pP][nN][gG] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[jJ][pP][gG] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[jJ][pP][eE][gG] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[tT][gG][aA] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[tT][iI][fF] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[tT][iI][fF][fF] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[eE][xX][rR] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[hH][dD][rR] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[pP][sS][dD] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[bB][mM][pP] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[gG][iI][fF] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[gG][lL][bB] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[gG][lL][tT][fF] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[fF][bB][xX] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[oO][bB][jJ] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[bB][lL][eE][nN][dD] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[wW][aA][vV] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[oO][gG][gG] filter=lfs diff=lfs merge=lfs -text
